    "gutterPx": {
      "mobile": 16,
      "tablet": 24,
      "desktop": 32
    }
  },
  "interaction": {
    "minimumTargetPx": 44,
    "transitionMs": 150,
    "respectReducedMotion": true
  },
  "pools": [
    {
      "id": "hunger-relief",
