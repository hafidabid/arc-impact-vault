{
  "$schemaDescription": "ImpactVault framework-neutral design tokens; proposed sizes and typography",
  "color": {
    "forest": "#164D42",
    "sage": "#91AD9D",
    "ivory": "#F8F8F3",
    "gold": "#D7B36B",
    "ink": "#20342F"
  },
  "semantic": {
    "background": "ivory",
    "text": "ink",
    "primary": "forest",
    "onPrimary": "ivory",
    "accent": "gold",
    "softSurface": "sage"
  },
  "typography": {
    "family": [
      "Inter",
      "system-ui",
      "-apple-system",
      "BlinkMacSystemFont",
      "Segoe UI",
      "sans-serif"
    ],
    "body": {
      "sizePx": 16,
      "lineHeight": 1.5,
      "weight": 400
    },
    "small": {
      "sizePx": 14,
      "lineHeight": 1.5
    },
    "heading": {
      "mobilePx": 28,
      "desktopPx": 36,
      "lineHeight": 1.2
